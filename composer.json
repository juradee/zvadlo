{
    "name": "juradee/zvadlo",
    "description": "Zvadlo – registrační systém pro jednotky Junáka – českého skauta",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "packages/skautis-nette",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/webwingscz/Skautis.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo_mysql": "*",
        "ext-soap": "*",
        "contributte/console": "^0.10",
        "contributte/scheduler": "^0.8",
        "latte/latte": "^3.1",
        "monolog/monolog": "^3.9",
        "nette/application": "^3.3",
        "nette/bootstrap": "^3.2",
        "nette/caching": "^3.3",
        "nette/di": "^3.2",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/mail": "^4.0",
        "nette/robot-loader": "^4.0",
        "nette/security": "^3.2",
        "nette/utils": "^4.0",
        "nettrine/dbal": "^0.10",
        "nettrine/fixtures": "^0.8",
        "nettrine/migrations": "^0.10",
        "nettrine/orm": "^0.10",
        "skaut/skautis": "^3.1",
        "tracy/tracy": "^2.10",
        "webwingscz/skautis-nette": "@dev"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.2",
        "codeception/module-db": "^3.2",
        "codeception/module-webdriver": "^4.0",
        "contributte/codeception": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.75",
        "mockery/mockery": "^1.6",
        "nextras/mail-panel": "^2.7",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-nette": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/dotenv": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
