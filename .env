# Development defaults. Override locally in .env.local (git-ignored); per-environment files
# .env.{APP_ENV} and .env.{APP_ENV}.local are loaded on top. Real environment variables win.
APP_ENV=dev
APP_BASE_URL=http://moje-hospodareni.cz
APP_RELEASE_HASH=dev
# 32 random bytes in base64; development value only, production sets its own.
APP_SECRET=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUtMTIzNA==

# Until Zvadlo has its own AppID the localhost AppID of h.skauting is used.
APPLICATION_ID=48104fe2-b447-47f5-9a26-051c710da74e
SKAUTIS_TEST_MODE=true
# Path to JSON fixtures; when set, skautIS is not called at all (used in ci).
SKAUTIS_FIXTURES=

DB_HOST=mariadb
DB_NAME=zvadlo
DB_USER=zvadlo
DB_PASSWORD=zvadlo

SEND_EMAIL=false
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
SYSTEM_EMAIL=
ERROR_EMAILS=

TEST_BACKGROUND=true
ENVIRONMENT_LABEL="Vývojový server"
ENVIRONMENT_COLOR=test
TRACY_SHOW_BAR=true

GOOGLE_CREDENTIALS_FILE=google-credentials.json
GOOGLE_REDIRECT_URI=

GITHUB_ISSUES_OWNER=juradee
GITHUB_ISSUES_REPOSITORY=zvadlo
GITHUB_ISSUES_LABELS=bug,user-report
GITHUB_ISSUES_TOKEN=

API_TOKEN_HSKAUTING=

RETENTION_MONTHS_SYNCED=12
RETENTION_MONTHS_UNSYNCED=24

SENTRY_DSN=
