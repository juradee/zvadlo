{
    "name": "webwingscz/skautis-nette",
    "description": "Nette integration of the skaut/skautis library: DI extension, session adapter, Tracy panel and JSON fixtures for tests",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jiří Dorazil",
            "homepage": "https://github.com/juradee"
        }
    ],
    "require": {
        "php": "^8.4",
        "nette/di": "^3.2",
        "nette/http": "^3.3",
        "nette/schema": "^1.3",
        "psr/event-dispatcher": "^1.0",
        "skaut/skautis": "^3.1"
    },
    "require-dev": {
        "nette/bootstrap": "^3.2",
        "phpunit/phpunit": "^12.0",
        "tracy/tracy": "^2.10"
    },
    "suggest": {
        "tracy/tracy": "to show skautIS calls in the Tracy bar"
    },
    "autoload": {
        "psr-4": {
            "Webwings\\SkautisNette\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webwings\\SkautisNette\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
