{block title}{$event->getName()}{/block}

{block content}
<div class="mb-3">
    <h1 class="h2 mb-1" data-test="event-name">{$event->getName()}</h1>
    <p class="lead mb-1">
        {$event->getDateFrom()|date:'d.m.Y'}{if $event->getDateTo() != $event->getDateFrom()} – {$event->getDateTo()|date:'d.m.Y'}{/if}
        <span n:if="$event->getPlace() !== null"> · {$event->getPlace()}</span>
    </p>
    <p class="text-body-secondary mb-0">
        <span n:if="$event->getPrice() !== null">Cena {$event->getPrice()} Kč · </span>
        Kontakt: {$event->getContactName()}, <a href="mailto:{$event->getContactEmail()}">{$event->getContactEmail()}</a>{if $event->getContactPhone() !== null}, {$event->getContactPhone()}{/if}
    </p>
</div>

<div class="card mb-3" data-test="registration-box">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        {if $publicRegistrationOpen}
            <span>Přihlašování je otevřené{if $event->getRegistrationDeadline() !== null} do {$event->getRegistrationDeadline()|date:'d.m.Y'}{/if}.</span>
            <span class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                <a n:href=":Web:Public:default unitId => $event->getUnitId(), slug => $event->getSlug(), t => $event->getWebToken()" class="btn btn-primary" data-test="public-register">Přihlásit se</a>
                <a n:href=":Web:Public:skautisLogin unitId => $event->getUnitId(), slug => $event->getSlug(), t => $event->getWebToken()" class="small" data-test="skautis-login">nebo přes skautIS</a>
            </span>
        {elseif $skautisLogin}
            <span>Přihlašování je otevřené{if $event->getRegistrationDeadline() !== null} do {$event->getRegistrationDeadline()|date:'d.m.Y'}{/if} pro každého s účtem ve skautISu.</span>
            <a n:href=":Web:Public:skautisLogin unitId => $event->getUnitId(), slug => $event->getSlug(), t => $event->getWebToken()" class="btn btn-primary" data-test="skautis-login">Přihlásit se přes skautIS</a>
        {else}
            <span>Pozvaní dostali <strong>osobní odkaz na přihlášku e-mailem</strong>; použijte ho. Bez pozvánky se ozvěte kontaktní osobě.</span>
        {/if}
    </div>
</div>

<div n:if="$descriptionHtml !== null" class="card mb-3" data-test="description">
    <div class="card-body">{$descriptionHtml|noescape}</div>
</div>

<div n:foreach="$blocks as $block" class="card mb-3" data-test="block-{$block['content']->getType()->value}">
    <div class="card-body">
        <h2 class="h5">{$block['content']->getTitle()}</h2>
        {if $block['html'] !== null}
            <div>{$block['html']|noescape}</div>
        {elseif $block['content'] instanceof App\Model\Web\FileContent}
            {var $file = $block['content']}
            <a n:href="file $file->getId()" target="_blank" rel="noopener" class="btn btn-outline-primary" data-test="file-link">
                {$file->isImage() ? 'Zobrazit obrázek' : 'Otevřít PDF'} · {$file->getOriginalName()} ({number_format($file->getSize() / 1024, 0, ',', ' ')} kB)
            </a>
        {elseif $block['content'] instanceof App\Model\Web\LinkContent}
            <a href="{$block['content']->getUrl()}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary" data-test="external-link">{$block['content']->getTitle()} ↗</a>
        {/if}
    </div>
</div>
{/block}
