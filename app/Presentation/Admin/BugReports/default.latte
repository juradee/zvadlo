{block title}Hlášení chyb – administrace{/block}

{block content}
<div class="small text-body-secondary mb-1"><a n:href=":Admin:Dashboard:default" class="link-secondary">Administrace</a></div>
<h1 class="h3 mb-3">Hlášení chyb</h1>

<div class="card mb-3">
    <div class="card-header">Nevyřízená <span class="badge text-bg-warning">{count($open)}</span></div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" data-test="bug-reports-open">
            <thead><tr><th>#</th><th>Nahlášeno</th><th>Uživatel</th><th>Role</th><th>URL</th><th>Popis</th><th></th></tr></thead>
            <tbody>
                <tr n:foreach="$open as $report" data-test="bug-report-row">
                    <td>{$report->getId()}</td>
                    <td class="text-nowrap">{$report->getCreatedAt()|date:'d.m.Y H:i'}</td>
                    <td>{$report->getReporterDisplayName()}<div class="small text-body-secondary">{$report->getReporterEmail() ?? '–'} · ID {$report->getReporterUserId()}</div></td>
                    <td class="small">{$report->getRoleName() ?? '–'}</td>
                    <td class="small text-truncate" style="max-width: 14rem">{$report->getReportedUrl() ?? '–'}</td>
                    <td class="small">{$report->getDescription()|truncate:90}</td>
                    <td><a n:href="detail $report->getId()" class="btn btn-sm btn-outline-primary">Detail</a></td>
                </tr>
                <tr n:if="$open === []"><td colspan="7" class="text-body-secondary" data-test="no-open-reports">Žádné nevyřízené hlášení.</td></tr>
            </tbody>
        </table>
    </div>
</div>
<div class="card">
    <div class="card-header">Vyřízená (posledních {count($resolved)})</div>
    <ul class="list-group list-group-flush small" data-test="bug-reports-resolved">
        <li n:foreach="$resolved as $report" class="list-group-item d-flex justify-content-between gap-2">
            <span><a n:href="detail $report->getId()">#{$report->getId()}</a> {$report->getReporterDisplayName()} · {$report->getDescription()|truncate:80}</span>
            <span class="text-nowrap"><span n:class="badge, $report->getResolutionState() === 'fixed' ? 'text-bg-success' : 'text-bg-secondary'">{$report->getResolutionState() === 'fixed' ? 'opraveno' : 'zamítnuto'}</span> {$report->getResolvedAt()|date:'d.m.Y'}</span>
        </li>
        <li n:if="$resolved === []" class="list-group-item text-body-secondary">Zatím žádné.</li>
    </ul>
</div>
{/block}
